{{- /* Profiles: chosen once per machine, stored in ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $profiles := list -}}
{{- if promptBoolOnce . "profiles.dev" "Enable 'dev' profile (PHP, Postgres, Zed, OrbStack)" -}}
{{-   $profiles = append $profiles "dev" -}}
{{- end -}}
{{- if promptBoolOnce . "profiles.ai" "Enable 'ai' profile (Claude, herdr, worktrunk)" -}}
{{-   $profiles = append $profiles "ai" -}}
{{- end -}}
{{- if promptBoolOnce . "profiles.desktop" "Enable 'desktop' profile (AeroSpace, Raycast, browsers, fonts)" -}}
{{-   $profiles = append $profiles "desktop" -}}
{{- end -}}
{{- if promptBoolOnce . "profiles.work" "Enable 'work' profile (Superscript git identity, Tuple, Linear)" -}}
{{-   $profiles = append $profiles "work" -}}
{{- end -}}
{{- if promptBoolOnce . "profiles.hobby3d" "Enable 'hobby3d' profile (Blender, Godot, Inkscape, PrusaSlicer)" -}}
{{-   $profiles = append $profiles "hobby3d" -}}
{{- end -}}
{{- if promptBoolOnce . "profiles.audio" "Enable 'audio' profile (BlackHole, rekordbox)" -}}
{{-   $profiles = append $profiles "audio" -}}
{{- end -}}

{{- /* Identity is read once at init time, from 1Password if `op` is installed
       and you opt in, otherwise from prompts. The resolved values land in the
       local chezmoi.toml, which is NOT part of this repo. */ -}}
{{- $use1p := false -}}
{{- if lookPath "op" -}}
{{-   $use1p = promptBoolOnce . "use1password" "Read identity from 1Password (op://Private/Dotfiles)" -}}
{{- end -}}
{{- $opFields := dict "name" "name" "email" "email" "signingkey" "signingkey" -}}
{{- $prompts := dict "name" "Git name" "email" "Git email" "signingkey" "GPG signing key fingerprint (leave empty to skip signing)" -}}
{{- if has "work" $profiles -}}
{{-   $_ := set $opFields "workName" "work name" -}}
{{-   $_ := set $opFields "workEmail" "work email" -}}
{{-   $_ := set $prompts "workName" "Work git name" -}}
{{-   $_ := set $prompts "workEmail" "Work git email" -}}
{{- end -}}

[data]
    use1password = {{ $use1p }}
{{- range $key, $field := $opFields }}
    {{ $key }} = {{ if $use1p }}{{ onepasswordRead (printf "op://Private/Dotfiles/%s" $field) "my.1password.com" | quote }}{{ else }}{{ promptStringOnce $ $key (index $prompts $key) | quote }}{{ end }}
{{- end }}
    enabledProfiles = {{ $profiles | toJson }}

[data.profiles]
{{- range $p := list "dev" "ai" "desktop" "work" "hobby3d" "audio" }}
    {{ $p }} = {{ has $p $profiles }}
{{- end }}
