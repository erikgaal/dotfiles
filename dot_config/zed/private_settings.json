// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    },
    "claude-acp": {
      "favorite_config_option_values": {
        "mode": [
          "plan"
        ]
      },
      "default_config_options": {
        "model": "default",
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  "disable_ai": false,
  "git_panel": {
    "dock": "right",
    "tree_view": true
  },
  "format_on_save": "off",
  "vim_mode": false,
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "languages": {
    "PHP": {
      "language_servers": [
        "phpantom_lsp",
        "!intelephense",
        "!phpactor",
        "!phptools",
      ],
    },
  },
  "lsp": {
    "phpantom_lsp": {
      "binary": {
        "path": "/usr/local/bin/phpantom_lsp"
      }
    }
  }
}
